---
/**
 * Yapışkan iletişim: masaüstünde sağ kenarda dikey koyu cam dock (WhatsApp · Ara · Teklif al) — üzerine
 * gelince etiket soldan açılır; mobilde altta üç düğmeli cam çubuk. Yalnızca doğrulanmış kanallar.
 */
import Icon from "@/components/ui/Icon.astro";
import { primaryPhone, whatsappHref } from "@/config/site";

interface Props {
  topic?: string | undefined;
}
const { topic } = Astro.props;
const phone = primaryPhone();
const wa = whatsappHref(topic);
---

<nav aria-label="Hızlı iletişim" class="rail fixed right-4 top-1/2 z-30 hidden -translate-y-1/2 flex-col gap-1.5 rounded-full border border-white/10 bg-[#0a0e11]/70 p-1.5 shadow-[0_30px_60px_-20px_rgba(0,0,0,0.8)] backdrop-blur-xl lg:flex">
  {
    wa && (
      <a href={wa} rel="noopener" target="_blank" class="rail-tab group" data-event="whatsapp_click" data-event-location="rail">
        <span class="rail-icon bg-[#15803d] text-white"><Icon name="whatsapp" size={20} /></span>
        <span class="rail-label">WhatsApp'tan yazın</span>
        <span class="sr-only">(yeni sekmede açılır)</span>
      </a>
    )
  }
  {
    phone && (
      <a href={phone.href} class="rail-tab group" data-event="call_click" data-event-location="rail">
        <span class="rail-icon bg-[#1e65b5] text-white"><Icon name="phone" size={19} /></span>
        <span class="rail-label">{phone.label}</span>
      </a>
    )
  }
  <a href="/teklif-al/" class="rail-tab group" data-event="quote_click" data-event-location="rail">
    <span class="rail-icon bg-[#f2f5f7] text-[#06080a]"><Icon name="quote" size={19} /></span>
    <span class="rail-label">Teklif alın</span>
  </a>
</nav>

<nav
  aria-label="Hızlı iletişim"
  class="mobile-bar fixed inset-x-3 bottom-3 z-30 grid grid-cols-3 gap-1 rounded-full border border-white/10 bg-[#0a0e11]/80 p-1.5 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.8)] backdrop-blur-xl lg:hidden"
  style="margin-bottom: env(safe-area-inset-bottom)"
>
  {phone && <a href={phone.href} class="mobile-bar-btn text-[#f2f5f7]" data-event="call_click" data-event-location="action_bar"><Icon name="phone" size={18} /> <span>Ara</span></a>}
  {wa && <a href={wa} rel="noopener" target="_blank" class="mobile-bar-btn bg-[#15803d] text-white" data-event="whatsapp_click" data-event-location="action_bar"><Icon name="whatsapp" size={18} /> <span>WhatsApp</span></a>}
  <a href="/teklif-al/" class="mobile-bar-btn bg-[#f2f5f7] text-[#06080a]" data-event="quote_click" data-event-location="action_bar"><Icon name="quote" size={18} /> <span>Teklif</span></a>
</nav>

<style>
  .rail-tab { position: relative; display: flex; align-items: center; justify-content: center; }
  .rail-icon {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .rail-tab:hover .rail-icon, .rail-tab:focus-visible .rail-icon { transform: scale(1.08); }
  .rail-label {
    position: absolute;
    right: calc(100% + 0.75rem);
    white-space: nowrap;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 999px;
    background: rgb(10 14 17 / 0.9);
    padding: 0.55rem 0.95rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #f2f5f7;
    opacity: 0;
    transform: translateX(8px);
    pointer-events: none;
    transition: opacity 300ms, transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
    backdrop-filter: blur(12px);
  }
  .rail-tab:hover .rail-label, .rail-tab:focus-visible .rail-label { opacity: 1; transform: none; }
  .mobile-bar-btn {
    display: flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>
