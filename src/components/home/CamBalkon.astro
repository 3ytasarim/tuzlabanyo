---
/**
 * Cam balkon ailesi. Solda kaydırmaya bağlı sürme panel çizimi (bölüm boyunca paneller
 * kayarak toplanır), sağda metin, tek cam / ısıcam kesiti ve gerçek uygulama fotoğrafları.
 * Fotoğraflar src/data/photos.ts'te family:"cam-balkon" olanlardan otomatik gelir.
 */
import Photo from "@/components/ui/Photo.astro";
import SplitHeading from "@/components/ui/SplitHeading.astro";
import { allPhotos } from "@/data/photos";
import Icon from "@/components/ui/Icon.astro";
import { servicesOf } from "@/data/services";

const others = servicesOf("cam-balkon").filter((s) => !["surme-cam-balkon", "isicamli-cam-balkon"].includes(s.slug));

const balconyPhotos = allPhotos.filter((p) => p.family === "cam-balkon");
const PANELS = 6;
---

<section id="cam-balkon" aria-labelledby="cam-balkon-title" class="on-night relative bg-night text-night-text" data-balcony>
  <div class="mx-auto grid max-w-[82.5rem] gap-12 px-5 py-20 sm:px-8 lg:grid-cols-12 lg:gap-8 lg:px-10 lg:py-28">
    <!-- Kaydırmaya bağlı çizim -->
    <div class="lg:col-span-6">
      <div class="lg:sticky lg:top-28">
        <p class="eyebrow">02 · Balkon</p>
        <SplitHeading id="cam-balkon-title" parts={[["Cam balkon"]]} class="mt-4 text-h2 font-semibold" />
        <div class="relative mt-10 overflow-hidden rounded-md border border-night-line bg-night-2 p-5 sm:p-8">
          <svg viewBox="0 0 600 340" class="balcony block h-auto w-full" role="img" aria-labelledby="balcony-desc">
            <title id="balcony-desc">Sürme cam balkon panellerinin ray üzerinde kayarak bir kenarda toplanmasını gösteren çizim</title>
            <defs>
              <linearGradient id="bal-sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#96c3ed" stop-opacity=".35" /><stop offset="1" stop-color="#96c3ed" stop-opacity=".05" />
              </linearGradient>
              <linearGradient id="bal-glass" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#e9f3fc" stop-opacity=".34" /><stop offset="1" stop-color="#96c3ed" stop-opacity=".12" />
              </linearGradient>
            </defs>
            <!-- manzara -->
            <rect x="30" y="40" width="540" height="230" fill="url(#bal-sky)" />
            <path d="M30 230 110 190 170 214 260 160 340 206 420 176 500 200 570 168V270H30Z" fill="#96c3ed" fill-opacity=".12" />
            <!-- korkuluk -->
            <rect x="30" y="270" width="540" height="40" fill="#10171b" stroke="#2a363c" />
            <!-- raylar -->
            <rect x="24" y="30" width="552" height="10" fill="#2a363c" />
            <rect x="24" y="266" width="552" height="8" fill="#2a363c" />
            <!-- paneller -->
            {
              Array.from({ length: PANELS }, (_, i) => (
                <g class="bal-panel" style={`--i:${i}`}>
                  <rect x={30 + i * 90} y="40" width="90" height="226" fill="url(#bal-glass)" stroke="#e9eef1" stroke-width="3" />
                  <path d={`M${44 + i * 90} 110 ${84 + i * 90} 66`} stroke="#fff" stroke-opacity=".4" stroke-width="2" />
                </g>
              ))
            }
          </svg>
          <div class="mt-5 flex items-center gap-4 text-xs font-semibold uppercase tracking-[0.18em] text-night-muted">
            <span>Kapalı</span>
            <span class="relative h-px flex-1 bg-night-line"><span class="balcony-meter absolute inset-y-0 left-0 bg-glass-light"></span></span>
            <span>Açık</span>
          </div>
        </div>
        <p class="mt-4 text-sm text-night-muted">Sayfayı kaydırdıkça paneller ray üzerinde kayıp bir kenarda toplanır.</p>
      </div>
    </div>

    <!-- Metin + kesitler + fotoğraflar -->
    <div class="flex flex-col gap-14 lg:col-span-5 lg:col-start-8 lg:pt-24">
      <p class="text-lead text-night-muted" data-reveal>
        Balkonu rüzgâra ve yağmura kapatırken manzarayı açık bırakır. Sistem ve cam tipi, balkonunuzun ölçüsüne ve
        kullanımına göre seçilir.
      </p>

      <div class="grid gap-4 sm:grid-cols-2" data-reveal>
        <a href="/surme-cam-balkon/" class="glass-night block rounded-xl p-6 transition-transform duration-500 ease-out-expo hover:-translate-y-1">
          <svg viewBox="0 0 120 70" class="h-16 w-auto" aria-hidden="true">
            <rect x="10" y="10" width="100" height="10" fill="#2a363c" /><rect x="10" y="50" width="100" height="10" fill="#2a363c" />
            <rect x="56" y="20" width="8" height="30" fill="#96c3ed" fill-opacity=".55" stroke="#e9eef1" />
          </svg>
          <h3 class="mt-4 font-display text-lg font-semibold">Sürme cam balkon</h3>
          <p class="mt-2 text-[0.9375rem] text-night-muted">Paneller ray üzerinde yana kayarak açılır ve bir kenarda üst üste toplanır.</p>
        </a>
        <a href="/isicamli-cam-balkon/" class="glass-night block rounded-xl p-6 transition-transform duration-500 ease-out-expo hover:-translate-y-1">
          <svg viewBox="0 0 120 70" class="h-16 w-auto" aria-hidden="true">
            <rect x="10" y="10" width="100" height="10" fill="#2a363c" /><rect x="10" y="50" width="100" height="10" fill="#2a363c" />
            <rect x="46" y="20" width="7" height="30" fill="#96c3ed" fill-opacity=".55" stroke="#e9eef1" />
            <rect x="67" y="20" width="7" height="30" fill="#96c3ed" fill-opacity=".55" stroke="#e9eef1" />
            <path d="M55 35h10" stroke="#96c3ed" stroke-dasharray="2 2" />
          </svg>
          <h3 class="mt-4 font-display text-lg font-semibold">Isıcamlı cam balkon</h3>
          <p class="mt-2 text-[0.9375rem] text-night-muted">İki cam arasındaki boşluk ısı geçişini azaltır; tek cama göre daha iyi yalıtım sağlar.</p>
        </a>
      </div>

      <div data-reveal>
        <p class="eyebrow">Diğer sistemler</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {others.map((o) => (
            <li><a href={`/${o.slug}/`} class="inline-flex min-h-11 items-center gap-2 rounded-full border border-night-line px-4 text-sm font-semibold hover:border-glass-light hover:text-glass-light">{o.name} <Icon name="arrow" size={14} /></a></li>
          ))}
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:gap-4">
        {
          balconyPhotos.map((p, i) => (
            <figure class:list={[i === 0 && balconyPhotos.length % 2 === 1 && "col-span-2"]} data-reveal>
              <Photo photo={p} ratio={i === 0 && balconyPhotos.length % 2 === 1 ? "16/10" : "3/4"} class="glare rounded-md" sizes="(min-width: 1024px) 20vw, 50vw" widths={[320, 480, 720, 960]} />
              <figcaption class="mt-2 text-xs text-night-muted">{p.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .bal-panel {
    /* --p: 0 kapalı → 1 açık. Her panel sol kenara, aralarında 7px kalacak şekilde kayar. */
    transform: translateX(calc(var(--p, 0) * var(--i) * -83px));
    transition: transform 120ms linear;
  }
  .balcony-meter { width: calc(var(--p, 0) * 100%); }
  @media (prefers-reduced-motion: reduce) {
    .bal-panel { transform: translateX(calc(var(--i) * -83px)); }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-balcony]");
  if (root && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let raf = 0;
    const update = () => {
      const r = root.getBoundingClientRect();
      const vh = window.innerHeight;
      // bölümün üstü ekranın üstüne değince başla (kapalı), altı ekranın altına gelince bitir (açık)
      const p = Math.min(1, Math.max(0, (vh * 0.15 - r.top) / Math.max(1, r.height - vh * 0.85)));
      root.style.setProperty("--p", p.toFixed(3));
    };
    const onScroll = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }
</script>
