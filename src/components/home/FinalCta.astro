---
/** Kapanış çağrısı: büyük geçişli başlık, ışık hüzmesi, parlayan butonlar. */
import Icon from "@/components/ui/Icon.astro";
import { BlurText } from "@/components/react/primitives";
import AuroraBackground from "@/components/react/AuroraBackground";
import { primaryPhone, whatsappHref } from "@/config/site";

interface Props {
  topic?: string | undefined;
  title?: string;
  lead?: string;
}
const {
  topic,
  title = "Banyonuz ya da balkonunuz için doğru çözümü birlikte bulalım.",
  lead = "Ölçüleri ve aklınızdaki sistemi anlatın; seçenekleri ve fiyatı birlikte netleştirelim.",
} = Astro.props;
const phone = primaryPhone();
const wa = whatsappHref(topic);
const words = title.split(" ");
const cut = Math.max(1, Math.floor(words.length * 0.55));
---

<section aria-labelledby="cta-title" class="relative isolate overflow-hidden px-5 py-28 sm:px-8 lg:px-10 lg:py-40">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute left-1/2 top-0 h-px w-[70%] -translate-x-1/2 bg-gradient-to-r from-transparent via-[#8ec5ff]/60 to-transparent"></div>
    <div class="absolute left-1/2 top-0 h-[34rem] w-[60rem] -translate-x-1/2 rounded-full bg-[radial-gradient(ellipse_at_top,rgba(47,125,225,0.28),transparent_65%)]"></div>
  </div>
  <AuroraBackground client:visible intensity={0.75} />
  <div class="mx-auto max-w-4xl text-center">
    <p class="eyebrow justify-center">Bize ulaşın</p>
    <BlurText
      client:visible
      id="cta-title"
      text={words.slice(0, cut).join(" ")}
      accent={words.slice(cut).join(" ")}
      className="mt-6 text-[clamp(2.25rem,1.3rem+3.4vw,4.75rem)] font-semibold leading-[1.02] tracking-[-0.045em] text-white"
    />
    <p class="mx-auto mt-7 max-w-xl text-lg leading-relaxed text-white/60">{lead}</p>
    <div class="mt-12 flex flex-wrap items-center justify-center gap-3">
      <a href="/teklif-al/" class="shimmer group relative inline-flex min-h-14 items-center gap-2.5 overflow-hidden rounded-full bg-[#f2f5f7] px-7 font-semibold text-[#06080a] transition-transform hover:scale-[1.03]" data-event="quote_click" data-event-location="final_cta">
        <span aria-hidden="true" class="shimmer-sweep pointer-events-none absolute inset-0"></span>
        <span class="relative inline-flex items-center gap-2.5"><Icon name="quote" /> Teklif alın</span>
      </a>
      {
        wa && (
          <a href={wa} rel="noopener" target="_blank" class="inline-flex min-h-14 items-center gap-2.5 rounded-full bg-[#15803d] px-7 font-semibold text-white shadow-[0_12px_40px_-12px_rgba(21,128,61,0.8)] transition-transform hover:scale-[1.03]" data-event="whatsapp_click" data-event-location="final_cta">
            <Icon name="whatsapp" /> WhatsApp <span class="sr-only">(yeni sekmede açılır)</span>
          </a>
        )
      }
      {
        phone && (
          <a href={phone.href} class="inline-flex min-h-14 items-center gap-2.5 rounded-full border border-white/15 bg-white/[0.04] px-7 font-semibold text-white backdrop-blur transition-colors hover:bg-white/10" data-event="call_click" data-event-location="final_cta">
            <Icon name="phone" /> {phone.label}
          </a>
        )
      }
    </div>
  </div>
</section>
