---
/**
 * Fotoğrafı henüz olmayan hizmetler için mimari çizim (fotoğraf değildir; "çizim temsilidir" notuyla kullanılır).
 * Hafif hareket: giyotin panelleri iner-kalkar, sürme paneller kayar; hareket azaltılmışsa sabit.
 */
import type { Illustration } from "@/data/services";

interface Props {
  kind: Illustration;
  title: string;
  class?: string;
}
const { kind, title, class: className } = Astro.props;
const id = `ill-${kind}`;
---

<svg viewBox="0 0 640 480" class:list={["ill block h-auto w-full", `ill--${kind}`, className]} role="img" aria-labelledby={`${id}-t`}>
  <title id={`${id}-t`}>{title}</title>
  <defs>
    <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#96c3ed" stop-opacity=".28" /><stop offset="1" stop-color="#96c3ed" stop-opacity=".04" />
    </linearGradient>
    <linearGradient id={`${id}-glass`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e9f3fc" stop-opacity=".36" /><stop offset="1" stop-color="#96c3ed" stop-opacity=".1" />
    </linearGradient>
  </defs>


  {
    kind === "kis-bahcesi" && (
      <g>
        <path d="M70 400 70 210 320 120 570 210 570 400Z" fill={`url(#${id}-sky)`} />
        <path d="M70 210 320 120 570 210" fill="none" stroke="#e9eef1" stroke-width="5" stroke-linejoin="round" />
        {[0, 1, 2, 3, 4].map((i) => (
          <path d={`M${120 + i * 100} ${192 - (i < 3 ? i : 4 - i) * 36} L${120 + i * 100} 400`} stroke="#e9eef1" stroke-width="3" opacity=".9" />
        ))}
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <rect x={70 + i * 83.3} y="260" width="83.3" height="140" fill={`url(#${id}-glass)`} stroke="#e9eef1" stroke-width="2.5" />
        ))}
        <path d="M70 210H570M70 260H570" stroke="#e9eef1" stroke-width="3" />
        <path d="M150 360q20-40 40 0M420 370q30-55 60 0" fill="none" stroke="#86efac" stroke-opacity=".6" stroke-width="3" />
        <rect x="50" y="400" width="540" height="14" fill="#2a363c" />
      </g>
    )
  }

  {
    kind === "giyotin" && (
      <g>
        <rect x="80" y="70" width="480" height="300" fill={`url(#${id}-sky)`} />
        <path d="M80 300 170 250 250 280 340 220 430 262 560 236V370H80Z" fill="#96c3ed" fill-opacity=".1" />
        <rect x="70" y="60" width="500" height="14" fill="#e9eef1" />
        {[0, 1, 2, 3].map((i) => <rect x={70 + i * 166} y="60" width="10" height="330" fill="#e9eef1" />)}
        <g class="ill-guillotine">
          {[0, 1, 2].map((i) => (
            <rect x={84 + i * 166} y="80" width="148" height="150" fill={`url(#${id}-glass)`} stroke="#e9eef1" stroke-width="3" />
          ))}
        </g>
        {[0, 1, 2].map((i) => (
          <rect x={84 + i * 166} y="232" width="148" height="150" fill={`url(#${id}-glass)`} stroke="#e9eef1" stroke-width="3" />
        ))}
        <rect x="60" y="384" width="520" height="40" fill="#10171b" stroke="#2a363c" />
      </g>
    )
  }

  {
    kind === "pergole" && (
      <g>
        <path d="M60 400H580" stroke="#2a363c" stroke-width="10" />
        <rect x="110" y="150" width="14" height="250" fill="#e9eef1" />
        <rect x="516" y="150" width="14" height="250" fill="#e9eef1" />
        <path d="M90 150H550" stroke="#e9eef1" stroke-width="16" />
        <g class="ill-lamels">
          {Array.from({ length: 12 }, (_, i) => (
            <rect x={104 + i * 36} y="112" width="24" height="34" rx="3" fill={`url(#${id}-glass)`} stroke="#e9eef1" stroke-width="2" style={`--k:${i}`} />
          ))}
        </g>
        <path d="M150 340h120v60M380 340h100v60" fill="none" stroke="#96c3ed" stroke-opacity=".5" stroke-width="3" />
        <path d="M200 70l-14 26M260 60l-14 26M320 70l-14 26M380 60l-14 26M440 70l-14 26" stroke="#96c3ed" stroke-opacity=".45" stroke-width="2" stroke-linecap="round" />
      </g>
    )
  }

  {
    kind === "aluminyum" && (
      <g>
        <rect x="90" y="70" width="460" height="330" fill="none" stroke="#e9eef1" stroke-width="12" />
        <path d="M320 70V400M90 250H550" stroke="#e9eef1" stroke-width="9" />
        <rect x="96" y="76" width="218" height="168" fill={`url(#${id}-sky)`} />
        <rect x="326" y="76" width="218" height="168" fill={`url(#${id}-sky)`} />
        <g class="ill-sash">
          <rect x="96" y="256" width="218" height="138" fill={`url(#${id}-glass)`} stroke="#96c3ed" stroke-width="3" />
        </g>
        <rect x="326" y="256" width="218" height="138" fill={`url(#${id}-glass)`} stroke="#96c3ed" stroke-width="3" />
        <path d="M120 120l60-36M360 120l60-36M120 300l50-30" stroke="#fff" stroke-opacity=".35" stroke-width="3" />
        <rect x="292" y="310" width="8" height="40" rx="3" fill="#e9eef1" />
        <g transform="translate(420 410)" fill="none" stroke="#96c3ed" stroke-width="3">
          <rect x="0" y="0" width="60" height="44" rx="4" />
          <path d="M14 0v44M46 0v44M0 22h14M46 22h14" />
        </g>
      </g>
    )
  }

  {
    kind === "surme" && (
      <g>
        <rect x="60" y="70" width="520" height="280" fill={`url(#${id}-sky)`} />
        <rect x="50" y="60" width="540" height="12" fill="#e9eef1" />
        <rect x="50" y="348" width="540" height="10" fill="#e9eef1" />
        <g class="ill-slide">
          {[0, 1, 2, 3, 4].map((i) => (
            <rect x={60 + i * 104} y="72" width="104" height="276" fill={`url(#${id}-glass)`} stroke="#e9eef1" stroke-width="3" style={`--k:${i}`} />
          ))}
        </g>
        <rect x="50" y="358" width="540" height="50" fill="#10171b" stroke="#2a363c" />
      </g>
    )
  }

  {
    kind === "isicam" && (
      <g>
        <rect x="150" y="70" width="40" height="340" fill="#e9eef1" />
        <rect x="450" y="70" width="40" height="340" fill="#e9eef1" />
        <rect x="270" y="70" width="22" height="340" fill={`url(#${id}-glass)`} stroke="#e9eef1" stroke-width="3" />
        <rect x="348" y="70" width="22" height="340" fill={`url(#${id}-glass)`} stroke="#e9eef1" stroke-width="3" />
        <rect x="292" y="70" width="56" height="340" fill="#96c3ed" fill-opacity=".08" />
        <g class="ill-heat" stroke="#fca5a5" stroke-width="3" fill="none" stroke-linecap="round">
          <path d="M200 160q20-10 40 0t40 0" /><path d="M200 240q20-10 40 0t40 0" /><path d="M200 320q20-10 40 0t40 0" />
        </g>
        <g stroke="#96c3ed" stroke-width="3" fill="none" stroke-linecap="round">
          <path d="M380 160q20-10 40 0t30 0" /><path d="M380 240q20-10 40 0t30 0" /><path d="M380 320q20-10 40 0t30 0" />
        </g>
        <text x="320" y="446" text-anchor="middle" fill="#a9b4ba" font-size="20" font-family="Montserrat, sans-serif" font-weight="600">çift cam · ara boşluk</text>
      </g>
    )
  }
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .ill-guillotine { animation: guillotine 6s var(--ease-out-expo) infinite; }
    .ill-lamels rect { transform-box: fill-box; transform-origin: center; animation: lamel 5s ease-in-out infinite; animation-delay: calc(var(--k) * 60ms); }
    .ill-sash { transform-box: fill-box; transform-origin: left center; animation: sash 6s ease-in-out infinite; }
    .ill-slide rect { animation: slide 7s var(--ease-out-expo) infinite; }
    .ill-heat { animation: heat 3s ease-in-out infinite; }
  }
  @keyframes guillotine { 0%, 20% { transform: translateY(0); } 50%, 70% { transform: translateY(150px); } 100% { transform: translateY(0); } }
  @keyframes lamel { 0%, 30% { transform: rotate(0deg); } 50%, 80% { transform: rotate(70deg); } 100% { transform: rotate(0deg); } }
  @keyframes sash { 0%, 30% { transform: perspective(600px) rotateY(0deg); } 50%, 80% { transform: perspective(600px) rotateY(-38deg); } 100% { transform: perspective(600px) rotateY(0deg); } }
  @keyframes slide { 0%, 20% { transform: translateX(0); } 50%, 70% { transform: translateX(calc(var(--k) * -96px)); } 100% { transform: translateX(0); } }
  @keyframes heat { 50% { transform: translateX(14px); opacity: 0.5; } }
</style>
