---
/** Hakkımızda: yalnızca doğrulanabilir bilgiler (kuruluş yılı, rakam, ekip sayısı yazılmaz). */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import ProcessTimeline from "@/components/react/ProcessTimeline";
import { processSteps } from "@/data/process";
import FinalCta from "@/components/home/FinalCta.astro";
import Photo from "@/components/ui/Photo.astro";
import Icon from "@/components/ui/Icon.astro";
import { familyList, servicesOf } from "@/data/services";
import { photos } from "@/data/photos";
import { site, verified, mapsUrl } from "@/config/site";
import { graph, webPageSchema, breadcrumbSchema } from "@/utils/schema";

const address = verified(site.address);
const url = `${site.url}/hakkimizda/`;
const crumbs = [
  { name: "Ana sayfa", href: "/" },
  { name: "Hakkımızda", href: "/hakkimizda/" },
];
const jsonLd = graph([
  webPageSchema({ type: "AboutPage", url, name: "Hakkımızda · Tuzla Duş", description: "Tuzla Duş: Tuzla'da duşakabin ve cam sistemleri imalatı ve montajı.", breadcrumbId: `${url}#breadcrumb` }),
  breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: new URL(c.href, site.url).href })), `${url}#breadcrumb`),
]);
const principles = [
  { t: "Fotoğraflar bizim işimiz", d: "Uygulamalarımız sayfasındaki ve hizmet sayfalarının örnekler bölümündeki fotoğrafların hepsi kendi işlerimizdir." },
  { t: "Her ölçüye imalat", d: "Hazır kalıp yerine alanınızın ölçüsünü esas alıyoruz. Kabin ya da cam sistemi, alınan ölçüye göre hazırlanır." },
  { t: "Banyo ve balkon tek adreste", d: "Duşakabinden cam balkona, kış bahçesinden alüminyum doğramaya kadar cam sistemlerini aynı yerden konuşabilirsiniz." },
];
---

<BaseLayout
  title="Hakkımızda · Tuzla Duş, Duşakabin ve Cam Sistemleri"
  description="Tuzla Duş, Tuzla Yayla Mahallesi'nde duşakabin, cam balkon ve cam sistemleri imalatı ve montajı yapar. Nasıl çalıştığımızı ve nerede olduğumuzu öğrenin."
  path="/hakkimizda/"
  jsonLd={jsonLd}
>
  <PageHero eyebrow="Hakkımızda" title="Banyoda ve balkonda" accent="camla çalışıyoruz." lead="Tuzla Duş; duşakabin, cam balkon ve cam sistemlerinin imalatını ve montajını yapar. Banyonuzu ve balkonunuzu ölçünüze göre kapatırız." crumbs={crumbs} photo={photos.kafesKose} />

  <section aria-labelledby="biz-title" class="mx-auto grid max-w-[82.5rem] gap-10 px-5 py-20 sm:px-8 lg:grid-cols-12 lg:gap-8 lg:px-10 lg:py-28">
    <div class="lg:col-span-5">
      <p class="eyebrow">Biz kimiz</p>
      <h2 id="biz-title" class="mt-4 text-h2 font-semibold">Tuzla Duş ne yapar?</h2>
    </div>
    <div class="space-y-5 text-lead text-muted lg:col-span-7" data-reveal>
      <p>
        Tuzla Duş, {address ? `${address.district} ${address.street.split(",")[0]}'nde` : "Tuzla'da"} bulunan, duşakabin ve cam sistemleri imalatı ve montajı yapan bir işletmedir.
        Banyoda köşe, oval ve iki duvar arası duşakabinler; balkon ve teraslarda cam balkon, giyotin cam, kış bahçesi ve pergole sistemleri; ayrıca alüminyum doğrama işleri yapıyoruz.
      </p>
      <p>
        Bazı banyo işlerimizde duşakabini zemin yenilemesiyle birlikte yaptık. Güncel uygulamalarımızı <a href={site.instagram} class="font-semibold text-glass link-underline" rel="noopener" target="_blank">Instagram hesabımızda</a> paylaşıyoruz.
      </p>
    </div>
  </section>

  <section aria-labelledby="ilke-title" class="on-night night-glow text-night-text">
    <div class="mx-auto max-w-[82.5rem] px-5 py-20 sm:px-8 lg:px-10 lg:py-28">
      <p class="eyebrow">Nasıl çalışırız</p>
      <h2 id="ilke-title" class="mt-4 text-h2 font-semibold">Üç ilke</h2>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {principles.map((p, i) => (
          <article class="glass-night rounded-2xl p-7" data-reveal style={`transition-delay:${i * 100}ms`}>
            <span class="font-display text-5xl font-bold text-glass-light/80 tabular-nums">0{i + 1}</span>
            <h3 class="mt-6 font-display text-xl font-semibold">{p.t}</h3>
            <p class="mt-3 text-night-muted">{p.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="neler-title" class="mx-auto grid max-w-[82.5rem] gap-10 px-5 py-20 sm:px-8 lg:grid-cols-12 lg:gap-8 lg:px-10 lg:py-28">
    <div class="grid grid-cols-2 gap-3 lg:col-span-6">
      <Photo photo={photos.siyahBantliKose} ratio="3/4" class="rounded-xl" sizes="(min-width: 1024px) 24vw, 45vw" widths={[480, 720, 960]} />
      <Photo photo={photos.isicamBalkon} ratio="3/4" class="mt-10 rounded-xl" sizes="(min-width: 1024px) 24vw, 45vw" widths={[480, 720, 960]} />
    </div>
    <div class="lg:col-span-5 lg:col-start-8">
      <p class="eyebrow">Hizmetler</p>
      <h2 id="neler-title" class="mt-4 text-h2 font-semibold">Neler yapıyoruz?</h2>
      {
        familyList.map((f) => (
          <div class="mt-8">
            <h3 class="font-display text-lg font-semibold"><a href={`/${f.slug}/`} class="link-underline hover:text-glass">{f.name}</a></h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {servicesOf(f.id).map((s) => (
                <li><a href={`/${s.slug}/`} class="inline-flex min-h-10 items-center rounded-full border border-line px-4 text-sm font-medium hover:border-ink">{s.name}</a></li>
              ))}
            </ul>
          </div>
        ))
      }
      <a href={mapsUrl()} rel="noopener" target="_blank" class="mt-10 inline-flex min-h-12 items-center gap-2 font-display font-semibold hover:text-glass">
        <Icon name="pin" /> <span class="link-underline">{address ? `${address.street}, ${address.district}` : site.district}</span>
        <span class="sr-only">(Google Haritalar yeni sekmede açılır)</span>
      </a>
    </div>
  </section>

  <ProcessTimeline client:visible steps={processSteps} title="İşi nasıl" accent="yürütüyoruz?" />
  <FinalCta />
</BaseLayout>
