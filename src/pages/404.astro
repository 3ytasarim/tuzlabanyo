---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import { primaryPhone } from "@/config/site";

const phone = primaryPhone();
---

<BaseLayout
  title="Sayfa bulunamadı · Tuzla Duş"
  description="Aradığınız sayfa bulunamadı. Ana sayfadan duşakabin ve cam balkon uygulamalarımıza ulaşabilirsiniz."
  path="/404.html"
  noindex
>
  <section class="mx-auto flex min-h-[70dvh] max-w-[82.5rem] flex-col justify-center px-5 pb-24 pt-36 sm:px-8 lg:px-10">
    <p class="eyebrow">404</p>
    <h1 class="mt-5 max-w-2xl text-h2 font-semibold">Bu sayfa yerinde yok.</h1>
    <p class="mt-5 max-w-xl text-lead text-muted">Bağlantı eskimiş ya da adres yanlış yazılmış olabilir.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/" size="lg">Ana sayfaya dön <Icon name="arrow" size={18} /></Button>
      {phone && <Button href={phone.href} size="lg" variant="secondary"><Icon name="phone" /> {phone.label}</Button>}
    </div>
  </section>
</BaseLayout>
